{
  "framework": null,
  "buildCommand": null,
  "regions": [
    "fra1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/de",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/it",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/v/:slug((?!_shared)[a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "^(www.)?namax.at$"
        }
      ],
      "destination": "https://:slug.namax.at/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v/_shared/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/venue/og.js": {
      "includeFiles": "{api/_lib/venues/og-fonts/**,node_modules/harfbuzzjs/**,node_modules/satori/**,node_modules/yoga-layout/**}"
    }
  },
  "rewrites": [
    {
      "source": "/liste",
      "destination": "/api/venue/admin"
    }
  ]
}
